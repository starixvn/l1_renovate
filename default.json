{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard"],
  "rangeStrategy": "update-lockfile",
  "timezone": "Asia/Ho_Chi_Minh",
  "packageRules": [
    {
      "description": "Only SC dependencies & devDependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies", "resolutions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "major", "digest"],
      "matchPackagePatterns": "^sc",
      "groupName": "SC dependencies",
      "automerge": false
    },
    {
      "description": "Major version upgrade - Other dependencies except SC",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "excludePackagePatterns": ["^sc"],
      "rangeStrategy": "update-lockfile",
      "extends": ["schedule:weekends"],
      "automerge": false
    },
    {
      "description": "Minor/patch version upgrade - Other dependencies except SC",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "excludePackagePatterns": ["^sc"],
      "rangeStrategy": "update-lockfile",
      "groupName": "External dependencies (non-major)",
      "automerge": false,
      "extends": ["schedule:weekends"]
    },
    {
      "description": "Minor/patch version upgrade - Dev dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "excludePackagePatterns": ["^sc"],
      "groupName": "devDependencies (non-major)",
      "automerge": false,
      "extends": ["schedule:weekends"]
    },
    {
      "description": "Major version upgrade - Dev dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "excludePackagePatterns": ["^sc"],
      "automerge": false,
      "extends": ["schedule:weekends"]
    }
  ]
}
