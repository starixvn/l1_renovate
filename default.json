{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "pin", "major", "digest"],
      "matchPackagePatterns": "^sc",
      "groupName": "SC dependencies",
      "rangeStrategy": "auto",
      "automerge": true,
      "schedule": ["after 5pm"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "excludePackagePatterns": ["^sc"],
      "groupName": "devDependencies",
      "rangeStrategy": "auto",
      "automerge": true,
      "extends": ["schedule:weekends"]
    }
  ]
}
