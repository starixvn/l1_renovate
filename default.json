{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "major", "patch", "digest"],
      "matchPackagePatterns": ["^sc"],
      "groupName": "all dependencies"
    }
  ]
}
